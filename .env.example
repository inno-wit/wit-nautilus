# Copy to .env and fill in real values. .env is gitignored.

# ── Committee mode ───────────────────────────────────────────────────────
# "llm" (default): wit.committee.live.LiveCommitteeProvider, needs everything in
# the LLM section below. "rules": wit.committee.rules.RulePolicyProvider —
# deterministic, no LLM/NaraRouter dependency at all, for both trade decisions
# and the weekly dream self-review (see wit/committee/rules.py). Adopted on the
# MT5 build's VPS after NaraRouter started silently 404ing there, abstaining
# every decision to HOLD with no visible error.
# WIT_COMMITTEE_MODE=rules

# ── LLM — two clients, split by decision authority (see wit/committee/live.py) ──
# PM client: direct Anthropic. Only this call authors a trade, so it stays off
# any substitution-prone gateway (Phase N3 design note).
ANTHROPIC_API_KEY=sk-ant-...
WIT_DEEP_MODEL=claude-haiku-4-5
# Optional: point the PM client at an Anthropic-compatible gateway instead of
# api.anthropic.com. Leave unset for direct Anthropic.
# ANTHROPIC_BASE_URL=
# Quick client: NaraRouter — bull/bear researcher commentary only, never
# executed on directly, so a free/non-Anthropic model here is an acceptable
# quality/cost tradeoff, not a real-money risk.
NARA_API_KEY=...
WIT_QUICK_MODEL=mistral-large
# NARA_BASE_URL=https://router.bynara.id
# Paces the committee's bull/bear/PM calls; 0 disables pacing. Set to your account's
# actual per-minute limit.
WIT_LLM_RPM_LIMIT=50

# ── Alpaca (execution, paper) — docs/whatif-we-used-alpaca-quirky-aurora.md ──
# Paper key/secret only, from the Alpaca dashboard's Paper Trading API Keys panel.
# node_live.py's assert_paper_only() refuses to boot unless ALPACA_PAPER=true
# regardless of what the key pair itself is - never relax this from .env alone.
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_PAPER=true

# ── Polygon/Massive (bar data) ───────────────────────────────────────────
# Free-tier defaults (5 req/min, ~15min delayed) - live-verified against this
# account during the broker swap, not assumed. Override only alongside a
# confirmed paid-tier upgrade.
POLYGON_API_KEY=...
# POLYGON_MAX_RPM=5
# POLYGON_POLL_INTERVAL_SECS=300
# POLYGON_DELAYED_MINUTES=15

# ── Optional integrations ─────────────────────────────────────────────
# FINNHUB_API_KEY=
# ALPHAVANTAGE_API_KEY=
# ALPHAVANTAGE_MAX_CALLS_PER_DAY=25
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Safety ───────────────────────────────────────────────────────────
# Hard lock — refuses to start against anything but a paper Alpaca account.
# Never relax this from a .env value; it's asserted in code at node boot (Phase N6).
WIT_PAPER_ONLY=true

# ── docker/compose.yml's fund service build arg (Phase N8) ──────────────
# Must match the deploy user's real uid (`id -u`) or the container's non-root `wit`
# user can't write the bind-mounted ../data (Phase N8 audit finding M2), including the
# kill switch. Goes in THIS file (repo root .env) - Compose's own .env lookup for
# build.args interpolation resolves against the directory `docker compose` is run from,
# which the documented `docker compose -f docker/compose.yml up -d` invocation makes the
# repo root. vps-setup.sh prints the right value at the end of its own output.
FUND_UID=1000
