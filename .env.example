# Copy to .env and fill in real values. .env is gitignored.

# ── LLM (Anthropic direct — see Phase N3 design note on why not a free-tier gateway) ──
ANTHROPIC_API_KEY=sk-ant-...
WIT_DEEP_MODEL=claude-opus-4.7
WIT_QUICK_MODEL=claude-sonnet-5
# Optional: point at an Anthropic-compatible gateway instead of api.anthropic.com
# ANTHROPIC_BASE_URL=
# Paces the committee's bull/bear/PM calls; 0 disables pacing. Set to your account's
# actual per-minute limit.
WIT_LLM_RPM_LIMIT=50

# ── Interactive Brokers (TWS or IB Gateway) ─────────────────────────────
# Local dev default: TWS running on this same machine. Under Docker Compose
# (docker/compose.yml, Phase N8), IBG_HOST/IBG_PORT are overridden to
# ib-gateway/4002 in the compose file itself - do not change these two lines for that,
# they're for running `wit paper` directly on a workstation with TWS open.
IBG_HOST=127.0.0.1
# Paper ports only - node_live.py's assert_paper_only() refuses to boot on
# anything else: 7497 = TWS paper, 4002 = IB Gateway paper.
# (Live ports 7496/4001 are never accepted regardless of WIT_PAPER_ONLY.)
IBG_PORT=7497
IBG_CLIENT_ID=1
TWS_ACCOUNT=DU...       # paper account id starts with DU

# ── docker/compose.yml's ib-gateway service (Phase N8) ──────────────────
# Only read by the ghcr.io/gnzsnz/ib-gateway container itself, never by `wit` -
# irrelevant for local TWS dev, required for the Docker deployment.
# TWS_USERID=
# TWS_PASSWORD=
# Leave unset except during the initial paper-account login/2FA session (see
# docker/compose.yml's own comments) - it enables a VNC server, one more credential to
# manage for a feature only needed once.
# VNC_SERVER_PASSWORD=

# ── Optional integrations ─────────────────────────────────────────────
# FINNHUB_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Safety ───────────────────────────────────────────────────────────
# Hard lock — refuses to start against anything but a paper/DU-prefixed account.
# Never relax this from a .env value; it's asserted in code at node boot (Phase N6).
WIT_PAPER_ONLY=true
