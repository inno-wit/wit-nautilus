# Copy to .env and fill in real values. .env is gitignored.

# ── LLM — two clients, split by decision authority (see wit/committee/live.py) ──
# PM client: direct Anthropic. Only this call authors a trade, so it stays off
# any substitution-prone gateway (Phase N3 design note).
ANTHROPIC_API_KEY=sk-ant-...
WIT_DEEP_MODEL=claude-haiku-4-5
# Optional: point the PM client at an Anthropic-compatible gateway instead of
# api.anthropic.com. Leave unset for direct Anthropic.
# ANTHROPIC_BASE_URL=
# Quick client: NaraRouter — bull/bear researcher commentary only, never
# executed on directly, so a free/non-Anthropic model here is an acceptable
# quality/cost tradeoff, not a real-money risk.
NARA_API_KEY=...
WIT_QUICK_MODEL=mistral-large
# NARA_BASE_URL=https://router.bynara.id
# Paces the committee's bull/bear/PM calls; 0 disables pacing. Set to your account's
# actual per-minute limit.
WIT_LLM_RPM_LIMIT=50

# ── Interactive Brokers (TWS or IB Gateway) ─────────────────────────────
# Local dev default: TWS running on this same machine. Under Docker Compose
# (docker/compose.yml, Phase N8), IBG_HOST/IBG_PORT are overridden to
# ib-gateway/4004 in the compose file itself - do not change these two lines for that,
# they're for running `wit paper` directly on a workstation with TWS open.
IBG_HOST=127.0.0.1
# Paper ports only - node_live.py's assert_paper_only() refuses to boot on
# anything else: 7497 = TWS paper, 4002 = IB Gateway paper.
# (Live ports 7496/4001 are never accepted regardless of WIT_PAPER_ONLY.)
IBG_PORT=7497
IBG_CLIENT_ID=1
TWS_ACCOUNT=DU...       # paper account id starts with DU

# ── docker/compose.yml's ib-gateway service (Phase N8) ──────────────────
# NOT here. TWS_USERID/TWS_PASSWORD/VNC_SERVER_PASSWORD - the ib-gateway container's own
# IBKR login - live in docker/ib-gateway.env (copy from docker/ib-gateway.env.example),
# a separate gitignored file, not this one (Phase N8 audit finding L2: a third-party
# image on a floating tag has no legitimate use for wit's own secrets below, or vice versa).

# ── Optional integrations ─────────────────────────────────────────────
# FINNHUB_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Safety ───────────────────────────────────────────────────────────
# Hard lock — refuses to start against anything but a paper/DU-prefixed account.
# Never relax this from a .env value; it's asserted in code at node boot (Phase N6).
WIT_PAPER_ONLY=true

# ── docker/compose.yml's fund service build arg (Phase N8) ──────────────
# Must match the deploy user's real uid (`id -u`) or the container's non-root `wit`
# user can't write the bind-mounted ../data (Phase N8 audit finding M2), including the
# kill switch. Goes in THIS file (repo root .env), not docker/ib-gateway.env - Compose's
# own .env lookup for build.args interpolation resolves against the directory `docker
# compose` is run from, which the documented `docker compose -f docker/compose.yml up -d`
# invocation makes the repo root. vps-setup.sh prints the right value at the end of its
# own output.
FUND_UID=1000
