# Copy to .env and fill in real values. .env is gitignored.

# ── LLM (Anthropic direct — see Phase N3 design note on why not a free-tier gateway) ──
ANTHROPIC_API_KEY=sk-ant-...
WIT_DEEP_MODEL=claude-opus-4.7
WIT_QUICK_MODEL=claude-sonnet-5
# Optional: point at an Anthropic-compatible gateway instead of api.anthropic.com
# ANTHROPIC_BASE_URL=

# ── Interactive Brokers (IB Gateway) ────────────────────────────────────
IBG_HOST=127.0.0.1
IBG_PORT=4002          # 4002 = paper, 4001 = live
IBG_CLIENT_ID=1
TWS_ACCOUNT=DU...       # paper account id starts with DU
# TWS_USERNAME / TWS_PASSWORD only needed if this process manages gateway login itself

# ── Optional integrations ─────────────────────────────────────────────
# FINNHUB_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Safety ───────────────────────────────────────────────────────────
# Hard lock — refuses to start against anything but a paper/DU-prefixed account.
# Never relax this from a .env value; it's asserted in code at node boot (Phase N6).
WIT_PAPER_ONLY=true
