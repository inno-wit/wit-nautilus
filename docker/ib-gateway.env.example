# Copy to docker/ib-gateway.env and fill in real values. That file is gitignored.
#
# Split from the repo's own .env (Phase N8 audit finding L2): ghcr.io/gnzsnz/ib-gateway is
# a third-party image on a deliberately unpinned floating tag (see compose.yml's own
# comment on why) - it has no legitimate use for ANTHROPIC_API_KEY, FINNHUB_API_KEY, or any
# of wit's other secrets, and wit's own `fund` container has no legitimate use for the IBKR
# login below. Two files, two blast radii.

TWS_USERID=
TWS_PASSWORD=

# Leave unset except during the initial paper-account login/2FA session (see compose.yml's
# own comments) - it enables a VNC server, one more credential to manage for a feature only
# needed once.
# VNC_SERVER_PASSWORD=
